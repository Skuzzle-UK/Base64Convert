<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Base64Convert.Controls"
             xmlns:views="clr-namespace:Base64Convert.Views"
             x:Class="Base64Convert.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,20" Spacing="16" MaximumWidthRequest="760">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Base64" FontAttributes="Bold" FontSize="26" VerticalOptions="Center"
                       TextColor="{DynamicResource TextPrimary}" />
                <controls:SegmentedControl x:Name="SectionSwitch" Grid.Column="1" WidthRequest="170"
                                           FirstText="Text" SecondText="Image"
                                           SelectionChanged="OnSectionChanged" />
            </Grid>

            <views:TextConverterView x:Name="TextSection" />
            <views:ImageConverterView x:Name="ImageSection" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
