<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Colours come from SystemTheme (device accent and surfaces) via DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource CardStroke}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="Count" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="Hint" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="Status" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="TextColor" Value="{DynamicResource Error}" />
    </Style>

    <!-- Row of action buttons along the bottom of a card. -->
    <Style x:Key="Actions" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="Code" TargetType="Editor">
        <Setter Property="FontFamily" Value="{OnPlatform WinUI=Consolas, Android=monospace}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="AutoSize" Value="Disabled" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="CodeOutput" TargetType="Label">
        <Setter Property="FontFamily" Value="{OnPlatform WinUI=Consolas, Android=monospace}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

</ResourceDictionary>
